{
    "github.copilot.nextEditSuggestions.enabled": true,
    "editor.fontFamily": "'Droid Sans Mono', 'monospace', monospace",
    "editor.fontSize": 14,
    "terminal.integrated.fontFamily": "Hack Nerd Font",
    "terminal.integrated.fontSize": 14,
    "workbench.colorTheme": "Catppuccin Macchiato",
    "workbench.iconTheme": "catppuccin-macchiato",
    "github.copilot.enable": {
        "markdown": true
    },
    "claudeCode.preferredLocation": "panel",
    "terminal.integrated.suggest.cdPath": "off",
    "terminal.integrated.suggest.enabled": false,
    "terminal.integrated.suggest.inlineSuggestion": "off",
    "terminal.integrated.suggest.providers": {
        "lsp": false,
        "vscode.terminal-suggest": false
    },
    "terminal.integrated.suggest.selectionMode": "never",
    "claudeCode.selectedModel": "default"
}